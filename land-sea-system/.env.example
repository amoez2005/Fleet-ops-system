DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=land_sea_db

# Optional: Prisma CLI can use this directly instead of the five fields above.
DATABASE_URL=mysql://your_database_user:your_database_password@127.0.0.1:3306/land_sea_db

JWT_SECRET=replace-with-a-long-random-secret
