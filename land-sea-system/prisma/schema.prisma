generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  FINANCE_MANAGER
  HR_ADMIN
  READ_ONLY
}

enum AssetStatus {
  AVAILABLE
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  HOLD
}

enum AssignmentStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets Asset[]
}

model Asset {
  id                String      @id @default(cuid())
  assetCode         String      @unique
  registrationNo    String?     @unique
  brand             String?
  model             String?
  specification     String?
  ownershipStatus   String?
  operationalStatus AssetStatus @default(AVAILABLE)
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  assignments        AssignmentAsset[]
  maintenanceRecords MaintenanceRecord[]
}

model Client {
  id            String       @id @default(cuid())
  clientCode    String       @unique
  companyName   String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  contractNotes String?
  invoiceTerms  String?
  status        ClientStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  assignments Assignment[]
  invoices    Invoice[]
}

model Assignment {
  id         String           @id @default(cuid())
  title      String?
  startDate  DateTime
  endDate    DateTime?
  location   String?
  rateType   String?
  rateValue  Decimal?         @db.Decimal(12, 2)
  jobNotes   String?
  status     AssignmentStatus @default(PLANNED)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  assets       AssignmentAsset[]
  revenues     Revenue[]
  invoiceLinks InvoiceAssignment[]
}

model AssignmentAsset {
  id           String @id @default(cuid())
  assignmentId String
  assetId      String

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, assetId])
}

model Revenue {
  id              String   @id @default(cuid())
  grossAmount     Decimal  @db.Decimal(12, 2)
  deductions      Decimal  @default(0) @db.Decimal(12, 2)
  netAmount       Decimal  @db.Decimal(12, 2)
  revenueDate     DateTime
  revenueCategory String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model SalaryRecord {
  id           String   @id @default(cuid())
  employeeName String
  roleTitle    String?
  salaryMonth  DateTime
  amount       Decimal  @db.Decimal(12, 2)
  paymentDate  DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Invoice {
  id          String        @id @default(cuid())
  invoiceNo   String        @unique
  issueDate   DateTime
  dueDate     DateTime
  subtotal    Decimal       @db.Decimal(12, 2)
  taxAmount   Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(DRAFT)
  paymentDate DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  assignments InvoiceAssignment[]
}

model InvoiceAssignment {
  id           String @id @default(cuid())
  invoiceId    String
  assignmentId String

  invoice    Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, assignmentId])
}

model MaintenanceRecord {
  id              String   @id @default(cuid())
  serviceType     String
  lastServiceDate DateTime?
  nextDueDate     DateTime?
  cost            Decimal? @db.Decimal(12, 2)
  vendor          String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assetId String
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  userId String?
  user   User? @relation(fields: [userId], references: [id])
}